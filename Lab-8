<!-- College Introduction -->
<div class="container-fluid bg-light text-center py-5">
    <h1 class="text-primary">Welcome to Marwadi University</h1>
    <p class="lead">Knowledge. Innovation. Excellence.</p>
    <p>Building skills and creating opportunities for students.</p>
</div>

<!-- Vision and Mission -->
<div class="container my-5" id="vision">
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="text-primary">Our Vision</h3>
                    <p>To become a leading educational institution by providing quality education, encouraging innovation, and developing responsible professionals.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="text-primary">Our Mission</h3>
                    <p>To provide quality education, promote research, develop technical skills, and prepare students for successful careers.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Program Specific Outcomes -->
<div class="container my-5">
    <h2 class="text-center text-primary mb-4">Program Specific Outcomes</h2>

    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5>PSO 1: Technical Skills</h5>
                    <p>Apply computer engineering knowledge to solve technical problems.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5>PSO 2: Software Development</h5>
                    <p>Develop software applications using programming languages and modern tools.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5>PSO 3: Problem Solving</h5>
                    <p>Use logical thinking and computing techniques to solve real-world problems.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Courses Offered -->
<div class="container my-5" id="courses">
    <h2 class="text-center text-primary mb-4">Courses Offered</h2>

    <div class="row text-center">
        <div class="col-md-4 mb-3">
            <div class="card p-3 h-100">
                <h5>B.Tech Computer Engineering</h5>
                <p>Programming, databases, networking and software development.</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card p-3 h-100">
                <h5>B.Tech Information Technology</h5>
                <p>Web technologies, information systems and cloud computing.</p>
